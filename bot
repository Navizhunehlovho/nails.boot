    )

# =========================================================
# SERVICE SELECT
# =========================================================

@dp.callback_query(F.data.startswith("service_"))
async def choose_service(call: CallbackQuery):

    service_key = call.data.replace(
        "service_",
        ""
    )

    service = SERVICES[service_key]

    text = (

        f"💖 <b>{service['name']}</b>\n\n"

        f"💰 Стоимость: {service['price']}\n\n"

        "Для записи и обсуждения "
        "деталей нажмите кнопку ниже 👇"
    )

    await call.message.answer(
        text,
        reply_markup=booking_keyboard(
            service_key
        )
    )

# =========================================================
# BOOKING CONFIRM
# =========================================================

@dp.callback_query(F.data.startswith("booked_"))
async def booking_confirm(call: CallbackQuery):

    service_key = call.data.replace(
        "booked_",
        ""
    )

    service = SERVICES[service_key]

    # =====================================================
    # ADMIN NOTIFY
    # =====================================================

    admin_text = (

        "🆕 <b>НОВАЯ ЗАПИСЬ</b>\n\n"

        f"👤 USER ID: {call.from_user.id}\n"

        f"📨 USERNAME: "
        f"@{call.from_user.username}\n\n"

        f"💅 Услуга:\n"
        f"{service['name']}\n\n"

        f"💰 Цена:\n"
        f"{service['price']}"
    )

    # =====================================================
    # SEND TO ADMINS
    # =====================================================

    for admin_id in ADMIN_IDS:

        try:

            await bot.send_message(
                admin_id,
                admin_text
            )

        except:
            pass

    # =====================================================
    # USER SUCCESS
    # =====================================================

    success_text = (

        "✅ <b>Запись отправлена!</b>\n\n"

        "Мастер уже получила "
        "вашу заявку 💖\n\n"

        "Ожидайте ответ в Telegram."
    )

    await call.message.answer(
        success_text
    )

# =========================================================
# MAIN
# =========================================================

async def main():

    print("NAIL STUDIO BOT STARTED")

    await dp.start_polling(bot)

# =========================================================

if __name__ == "__main__":
    asyncio.run(main())
