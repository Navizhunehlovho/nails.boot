# =========================================================
# KEYBOARDS
# =========================================================

def main_menu():

    return ReplyKeyboardMarkup(

        keyboard=[

            [
                KeyboardButton(text="💅 Услуги"),
                KeyboardButton(text="💰 Прайс")
            ],

            [
                KeyboardButton(text="🖼 Портфолио"),
                KeyboardButton(text="📞 Контакты")
            ]
        ],

        resize_keyboard=True
    )

# =========================================================

def services_keyboard():

    return InlineKeyboardMarkup(

        inline_keyboard=[

            [
                InlineKeyboardButton(
                    text="💅 Классический — 1500₽",
                    callback_data="service_classic"
                )
            ],

            [
                InlineKeyboardButton(
                    text="✨ Гель-лак — 2500₽",
                    callback_data="service_gel"
                )
            ],

            [
                InlineKeyboardButton(
                    text="🎨 Дизайн ногтей — 3000₽",
                    callback_data="service_design"
                )
            ]
        ]
    )

# =========================================================

def booking_keyboard(service_key):

    service = SERVICES[service_key]

    return InlineKeyboardMarkup(

        inline_keyboard=[

            [
                InlineKeyboardButton(
                    text="💌 Связаться с мастером",
                    url=service["master_link"]
                )
            ],

            [
                InlineKeyboardButton(
                    text="✅ Я записалась",
                    callback_data=f"booked_{service_key}"
                )
            ]
        ]
    )

# =========================================================
# START
# =========================================================

@dp.message(Command("start"))
async def start(message: Message):

    photo = FSInputFile(WELCOME_PHOTO)

    await message.answer_photo(
        photo=photo,
        reply_markup=main_menu()
    )

